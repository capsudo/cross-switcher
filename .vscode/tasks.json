{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "(re)build extension",
      "type": "shell",
      "command": "make",
      "args": [
        "all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "build and link extension",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/build-and-link-extension.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "(re)start shell with extension",
      "type": "shell",
      "command": "bash",
      "dependsOn": [
        "(re)build extension"
      ],
      "dependsOrder": "sequence",
      "args": [
        "scripts/start-nested-shell-with-extension.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    }
  ]
}
